TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_ALLOWED_IDS=111111111,222222222

WB_TOKEN_1=put_first_wb_token_here
WB_CABINET_1_NAME=Кабинет 1
WB_TOKEN_2=put_second_wb_token_here
WB_CABINET_2_NAME=Кабинет 2

# 14 дней истории заказов
WB_LOOKBACK_DAYS=14
# История файлов хранится 4 дня
HISTORY_RETENTION_DAYS=4
# Старый параметр сохранён для совместимости
NO_SALES_TARGET_PER_WAREHOUSE=2
# Страховой минимум на каждый доступный FBS-склад
SAFETY_STOCK_PER_WAREHOUSE=4
# Порог: если остаток <=20, распределить всё; если >20 — дробный хвост оставить в запасе
DISTRIBUTE_ALL_THRESHOLD=20

# Необязательно: отдельные токены для сравнения цен, если основные ключи WB_TOKEN_1/2
# не имеют категорий «Цены и скидки» и «Статистика». Если оставлены пустыми,
# используются соответствующие WB_TOKEN_1/2.
# WB_PRICES_TOKEN_1=
# WB_PRICES_TOKEN_2=
# WB_STATS_TOKEN_1=
# WB_STATS_TOKEN_2=

# Для отчёта сравнения цен: токены с правом «Аналитика» для получения остатков FBO.
# Если основной WB_TOKEN_1/2 уже содержит категорию «Аналитика», можно оставить пустыми.
WB_ANALYTICS_TOKEN_1=
WB_ANALYTICS_TOKEN_2=
